    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@sentry/react-native": "8.20.0",
    "@supabase/supabase-js": "2.105.4",
    "expo": "~56.0.3",
    "expo-build-properties": "~56.0.13",
    "expo-constants": "~56.0.14",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-notifications": "~56.0.13",
    "expo-router": "~56.2.5",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
